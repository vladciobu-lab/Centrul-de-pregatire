---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact"
  description="Contactează Centrul de Pregătire Constanța. Programează o ședință de cunoaștere gratuită sau scrie-ne cu orice întrebare."
>
  <!-- Hero -->
  <section class="py-16 lg:py-20 bg-gradient-to-br from-[#FAF3E7] to-[#F0E4D5]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-heading text-4xl lg:text-5xl font-bold text-[#6B1F2E] mb-6 reveal">Ia legătura cu noi</h1>
      <p class="text-lg text-[#6B5B5E] max-w-2xl mx-auto reveal" style="transition-delay:0.1s">
        Orice întrebare e binevenită — despre materii, prețuri, program sau orice altceva.
      </p>
    </div>
  </section>

  <!-- Content -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-10 lg:gap-16">

        <!-- Formular -->
        <div class="lg:col-span-3 reveal">
          <h2 class="font-heading text-2xl font-bold text-[#2A1518] mb-6">Trimite-ne un mesaj</h2>

          <!--
            FORMSPREE: Înlocuiește PLACEHOLDER_FORMSPREE_ID cu ID-ul tău de pe formspree.io
            Pași:
            1. Mergi pe https://formspree.io și creează un cont gratuit
            2. Creează un nou form și copiază ID-ul (ex: xpzgebkj)
            3. Înlocuiește PLACEHOLDER_FORMSPREE_ID de mai jos cu acel ID
            4. Salvează și fă deploy
          -->
          <form
            action="https://formspree.io/f/PLACEHOLDER_FORMSPREE_ID"
            method="POST"
            id="contact-form"
            class="space-y-5"
          >
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="nume" class="block text-sm font-medium text-[#2A1518] mb-1.5">Nume și prenume <span class="text-[#6B1F2E]">*</span></label>
                <input
                  type="text"
                  id="nume"
                  name="nume"
                  required
                  placeholder="Ion Popescu"
                  class="w-full px-4 py-3 rounded-xl border border-[#E8DDD0] bg-[#FAF3E7] text-[#2A1518] placeholder-[#6B5B5E]/60 focus:outline-none focus:border-[#6B1F2E] focus:bg-white transition-colors text-sm"
                />
              </div>
              <div>
                <label for="telefon" class="block text-sm font-medium text-[#2A1518] mb-1.5">Telefon <span class="text-[#6B1F2E]">*</span></label>
                <input
                  type="tel"
                  id="telefon"
                  name="telefon"
                  required
                  placeholder="07XX XXX XXX"
                  class="w-full px-4 py-3 rounded-xl border border-[#E8DDD0] bg-[#FAF3E7] text-[#2A1518] placeholder-[#6B5B5E]/60 focus:outline-none focus:border-[#6B1F2E] focus:bg-white transition-colors text-sm"
                />
              </div>
            </div>

            <div>
              <label for="email" class="block text-sm font-medium text-[#2A1518] mb-1.5">Email <span class="text-[#6B1F2E]">*</span></label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="email@exemplu.ro"
                class="w-full px-4 py-3 rounded-xl border border-[#E8DDD0] bg-[#FAF3E7] text-[#2A1518] placeholder-[#6B5B5E]/60 focus:outline-none focus:border-[#6B1F2E] focus:bg-white transition-colors text-sm"
              />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="materie" class="block text-sm font-medium text-[#2A1518] mb-1.5">Materia <span class="text-[#6B1F2E]">*</span></label>
                <select
                  id="materie"
                  name="materie"
                  required
                  class="w-full px-4 py-3 rounded-xl border border-[#E8DDD0] bg-[#FAF3E7] text-[#2A1518] focus:outline-none focus:border-[#6B1F2E] focus:bg-white transition-colors text-sm appearance-none cursor-pointer"
                >
                  <option value="" disabled selected>Alege materia</option>
                  <option>Limba și Literatura Română</option>
                  <option>Matematică</option>
                  <option>Logică, Argumentare și Comunicare</option>
                  <option>Istorie</option>
                  <option>Geografie</option>
                  <option>Biologie</option>
                  <option>Nu știu încă</option>
                </select>
              </div>
              <div>
                <label for="scop" class="block text-sm font-medium text-[#2A1518] mb-1.5">Pentru ce? <span class="text-[#6B1F2E]">*</span></label>
                <select
                  id="scop"
                  name="scop"
                  required
                  class="w-full px-4 py-3 rounded-xl border border-[#E8DDD0] bg-[#FAF3E7] text-[#2A1518] focus:outline-none focus:border-[#6B1F2E] focus:bg-white transition-colors text-sm appearance-none cursor-pointer"
                >
                  <option value="" disabled selected>Alege scopul</option>
                  <option>Evaluare Națională (EN)</option>
                  <option>Bacalaureat (BAC)</option>
                  <option>Recuperare la materie</option>
                  <option>Nu știu încă</option>
                </select>
              </div>
            </div>

            <div>
              <label for="mesaj" class="block text-sm font-medium text-[#2A1518] mb-1.5">Mesaj</label>
              <textarea
                id="mesaj"
                name="mesaj"
                rows="4"
                placeholder="Spune-ne mai multe despre situația ta — clasa, la ce ai nevoie de ajutor, câtă vreme ai până la examen..."
                class="w-full px-4 py-3 rounded-xl border border-[#E8DDD0] bg-[#FAF3E7] text-[#2A1518] placeholder-[#6B5B5E]/60 focus:outline-none focus:border-[#6B1F2E] focus:bg-white transition-colors text-sm resize-none"
              ></textarea>
            </div>

            <!-- Consimțământ GDPR -->
            <div class="flex items-start gap-3">
              <input type="checkbox" id="gdpr" name="gdpr" required class="mt-1 w-4 h-4 accent-[#6B1F2E] cursor-pointer" />
              <label for="gdpr" class="text-xs text-[#6B5B5E] leading-relaxed cursor-pointer">
                Sunt de acord cu prelucrarea datelor mele personale conform
                <a href="/confidentialitate" class="text-[#6B1F2E] hover:underline">Politicii de Confidențialitate</a>.
                Datele sunt folosite doar pentru a-ți răspunde la mesaj.
              </label>
            </div>

            <button
              type="submit"
              id="submit-btn"
              class="w-full bg-[#6B1F2E] text-white py-3.5 rounded-xl font-semibold hover:bg-[#4E1520] transition-colors text-sm shadow-md disabled:opacity-60 disabled:cursor-not-allowed"
            >
              <span id="btn-text">Trimite mesajul</span>
            </button>

            <!-- Mesaj succes -->
            <div id="success-msg" class="hidden bg-green-50 border border-green-200 rounded-xl p-4 text-center">
              <p class="text-green-700 font-semibold">✓ Mesajul a fost trimis!</p>
              <p class="text-green-600 text-sm mt-1">Îți răspundem de obicei în aceeași zi.</p>
            </div>

            <!-- Mesaj eroare -->
            <div id="error-msg" class="hidden bg-red-50 border border-red-200 rounded-xl p-4 text-center">
              <p class="text-red-700 text-sm">A apărut o eroare. Încearcă din nou sau scrie-ne pe WhatsApp.</p>
            </div>
          </form>
        </div>

        <!-- Info contact -->
        <div class="lg:col-span-2 reveal" style="transition-delay:0.15s">
          <h2 class="font-heading text-2xl font-bold text-[#2A1518] mb-6">Contact direct</h2>

          <div class="space-y-5">
            <!-- Telefon -->
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-[#6B1F2E]/10 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-[#6B1F2E]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <div>
                <p class="text-sm font-medium text-[#2A1518] mb-0.5">Telefon</p>
                <a href="tel:+40721628936" class="text-[#6B1F2E] font-semibold hover:underline">+40 721 628 936</a>
                <p class="text-[#6B5B5E] text-xs mt-0.5">Lun–Sâm 9:00–20:00</p>
              </div>
            </div>

            <!-- Email -->
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-[#6B1F2E]/10 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-[#6B1F2E]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <p class="text-sm font-medium text-[#2A1518] mb-0.5">Email</p>
                <a href="mailto:contact@centruldepregatire.ro" class="text-[#6B1F2E] font-semibold hover:underline text-sm">contact@centruldepregatire.ro</a>
              </div>
            </div>

            <!-- Adresă -->
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-[#6B1F2E]/10 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-[#6B1F2E]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <div>
                <p class="text-sm font-medium text-[#2A1518] mb-0.5">Sediu</p>
                <p class="text-[#6B5B5E] text-sm">Constanța, România</p>
                <p class="text-[#6B5B5E] text-xs mt-0.5">(adresa exactă se comunică la programare)</p>
                <!-- Înlocuiește cu link-ul real Google Maps -->
                <a href="https://maps.google.com" target="_blank" rel="noopener noreferrer" class="text-[#6B1F2E] text-xs hover:underline mt-1 inline-block">
                  Vezi pe hartă →
                </a>
              </div>
            </div>

            <!-- Program -->
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-[#6B1F2E]/10 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-[#6B1F2E]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <div>
                <p class="text-sm font-medium text-[#2A1518] mb-1">Program</p>
                <div class="space-y-0.5 text-sm text-[#6B5B5E]">
                  <p>Luni – Vineri: 9:00 – 20:00</p>
                  <p>Sâmbătă: 9:00 – 17:00</p>
                  <p>Duminică: 10:00 – 15:00</p>
                </div>
              </div>
            </div>
          </div>

          <!-- WhatsApp CTA -->
          <div class="mt-8 bg-[#FAF3E7] rounded-2xl p-5 border border-[#E8DDD0]">
            <p class="text-[#2A1518] text-sm font-medium mb-3">Preferi WhatsApp?</p>
            <a
              href="https://wa.me/40721628936?text=Bun%C4%83!%20Sunt%20interesat%20de%20medita%C8%9Bii%20la%20Centrul%20de%20Preg%C4%83tire"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3 bg-[#25D366] text-white px-5 py-3 rounded-xl font-semibold hover:bg-[#1da851] transition-colors text-sm"
            >
              <svg class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Scrie-ne pe WhatsApp
            </a>
            <p class="text-[#6B5B5E] text-xs mt-3">De obicei răspundem în câteva ore.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text');
  const successMsg = document.getElementById('success-msg');
  const errorMsg = document.getElementById('error-msg');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (submitBtn) {
      submitBtn.disabled = true;
      if (btnText) btnText.textContent = 'Se trimite...';
    }

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });

      if (response.ok) {
        form.reset();
        successMsg?.classList.remove('hidden');
        errorMsg?.classList.add('hidden');
      } else {
        errorMsg?.classList.remove('hidden');
        successMsg?.classList.add('hidden');
      }
    } catch {
      errorMsg?.classList.remove('hidden');
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        if (btnText) btnText.textContent = 'Trimite mesajul';
      }
    }
  });
</script>
