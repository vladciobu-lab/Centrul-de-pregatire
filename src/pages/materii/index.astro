---
import Layout from '../../layouts/Layout.astro';
import { materii } from '../../lib/data';
---

<Layout
  title="Materii"
  description="Meditații la Română, Matematică, Logică, Istorie, Geografie și Biologie în Constanța. Pregătire EN, BAC și recuperare la orice clasă."
>
  <!-- Hero -->
  <section class="py-16 lg:py-20 bg-gradient-to-br from-[#FAF3E7] to-[#F0E4D5]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-heading text-4xl lg:text-5xl font-bold text-[#6B1F2E] mb-6 reveal">Materiile pe care le predăm</h1>
      <p class="text-lg text-[#6B5B5E] max-w-2xl mx-auto reveal" style="transition-delay:0.1s">
        Alegem materiile pe care le cunoaștem bine și le explicăm clar. Apasă pe oricare să afli mai mult.
      </p>
    </div>
  </section>

  <!-- Grid materii -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {materii.map((materie, i) => (
          <a
            href={`/materii/${materie.slug}`}
            class="group block bg-[#FAF3E7] rounded-2xl p-7 border border-[#E8DDD0] hover:shadow-lg hover:-translate-y-1 transition-all duration-300 reveal"
            style={`transition-delay:${i*0.08}s`}
          >
            <div class={`w-14 h-14 ${materie.culoare} rounded-2xl flex items-center justify-center text-3xl mb-5`}>
              {materie.icon}
            </div>
            <h2 class="font-heading text-xl font-bold text-[#2A1518] mb-3 group-hover:text-[#6B1F2E] transition-colors">
              {materie.titlu}
            </h2>
            <p class="text-[#6B5B5E] text-sm leading-relaxed mb-4">{materie.descriere}</p>
            <div class="flex flex-wrap gap-2 mb-4">
              {materie.examene.map((ex) => (
                <span class="text-xs bg-white text-[#6B5B5E] px-3 py-1 rounded-full border border-[#E8DDD0] font-medium">{ex}</span>
              ))}
              <span class="text-xs bg-white text-[#6B5B5E] px-3 py-1 rounded-full border border-[#E8DDD0] font-medium">Recuperare</span>
            </div>
            <span class="inline-flex items-center gap-1 text-[#6B1F2E] text-sm font-semibold group-hover:gap-2 transition-all">
              Detalii
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-[#FAF3E7]">
    <div class="max-w-2xl mx-auto px-4 text-center reveal">
      <h2 class="font-heading text-2xl font-bold text-[#2A1518] mb-4">Nu găsești materia ta?</h2>
      <p class="text-[#6B5B5E] mb-6">Scrie-ne și vedem ce putem face. Uneori luăm și solicitări în afara listei de mai sus.</p>
      <a href="/contact" class="inline-flex items-center gap-2 bg-[#6B1F2E] text-white px-7 py-3.5 rounded-xl font-semibold hover:bg-[#4E1520] transition-colors shadow-md hover:-translate-y-0.5">
        Contactează-ne
      </a>
    </div>
  </section>
</Layout>
