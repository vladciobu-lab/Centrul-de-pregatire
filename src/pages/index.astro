---
import Layout from '../layouts/Layout.astro';
import { testimoniale, materii } from '../lib/data';

const featuredTestimoniale = testimoniale.slice(0, 4);
---

<Layout
  title="Acasă"
  description="Meditații în Constanța pentru orice clasă și orice materie. Pregătire EN, BAC și recuperare. Ședință de cunoaștere gratuită. Plecăm de unde ești tu."
>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-gradient-to-br from-[#FAF3E7] via-[#F5EDE0] to-[#F0E4D5] py-20 lg:py-32">
    <div class="absolute inset-0 opacity-5 pointer-events-none">
      <div class="absolute top-10 left-10 w-64 h-64 bg-[#6B1F2E] rounded-full blur-3xl"></div>
      <div class="absolute bottom-10 right-10 w-80 h-80 bg-[#2C6E7F] rounded-full blur-3xl"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <img
        src="/logo.jpeg"
        alt="Centrul de Pregătire Constanța"
        class="mx-auto h-28 lg:h-36 w-auto rounded-2xl shadow-lg mb-8 reveal"
        width="140"
        height="140"
      />
      <h1 class="font-heading text-4xl sm:text-5xl lg:text-6xl font-bold text-[#6B1F2E] mb-6 reveal" style="transition-delay:0.1s">
        From 0 to Hero
      </h1>
      <p class="text-lg sm:text-xl lg:text-2xl text-[#2A1518] max-w-2xl mx-auto mb-4 reveal" style="transition-delay:0.2s">
        Meditații care pleacă de unde ești tu.
      </p>
      <p class="text-base sm:text-lg text-[#6B5B5E] max-w-xl mx-auto mb-10 reveal" style="transition-delay:0.25s">
        Pentru orice clasă, orice materie, orice nivel. Constanța.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center reveal" style="transition-delay:0.3s">
        <a
          href="/servicii#cunostinta"
          class="inline-flex items-center justify-center gap-2 bg-[#6B1F2E] text-white px-7 py-3.5 rounded-xl text-base font-semibold hover:bg-[#4E1520] transition-all duration-200 shadow-md hover:shadow-lg hover:-translate-y-0.5"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          Ședință gratuită
        </a>
        <a
          href="#cum-lucram"
          class="inline-flex items-center justify-center gap-2 bg-white text-[#6B1F2E] border-2 border-[#6B1F2E] px-7 py-3.5 rounded-xl text-base font-semibold hover:bg-[#FAF3E7] transition-all duration-200 hover:-translate-y-0.5"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
          Vezi cum lucrăm
        </a>
      </div>
    </div>
  </section>

  <!-- PENTRU CINE -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 reveal">
        <h2 class="font-heading text-3xl lg:text-4xl font-bold text-[#2A1518] mb-4">Pentru cine suntem aici</h2>
        <p class="text-[#6B5B5E] text-lg max-w-xl mx-auto">Venim cu tine de unde ești, nu de unde ar trebui să fii.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a href="/servicii#examen" class="group block bg-gradient-to-br from-[#FAF3E7] to-[#F5EDE0] border border-[#E8DDD0] rounded-2xl p-7 hover:shadow-lg transition-all duration-300 hover:-translate-y-1 reveal">
          <div class="w-12 h-12 bg-[#6B1F2E]/10 rounded-xl flex items-center justify-center mb-5 text-2xl">🎯</div>
          <h3 class="font-heading text-xl font-bold text-[#6B1F2E] mb-3">Te pregătești de Evaluare Națională?</h3>
          <p class="text-[#6B5B5E] text-sm leading-relaxed mb-4">Clasa a 8-a, Română și Matematică. Acoperim toată programa, facem simulări, exersăm subiecte tip EN. Plecăm de unde ești în acest moment.</p>
          <span class="inline-flex items-center gap-1 text-[#6B1F2E] text-sm font-semibold group-hover:gap-2 transition-all">Află mai mult <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
        </a>
        <a href="/servicii#examen" class="group block bg-gradient-to-br from-[#6B1F2E] to-[#8B2F42] rounded-2xl p-7 text-white hover:shadow-xl transition-all duration-300 hover:-translate-y-1 reveal" style="transition-delay:0.1s">
          <div class="w-12 h-12 bg-white/20 rounded-xl flex items-center justify-center mb-5 text-2xl">📚</div>
          <h3 class="font-heading text-xl font-bold mb-3">Te pregătești de Bacalaureat?</h3>
          <p class="text-white/80 text-sm leading-relaxed mb-4">Clasa a 12-a. Pregătire structurată, simulări, subiecte din sesiunile anterioare. Nu e imposibil — e un examen care se pregătește.</p>
          <span class="inline-flex items-center gap-1 text-[#E8B4BC] text-sm font-semibold group-hover:gap-2 transition-all">Află mai mult <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
        </a>
        <a href="/servicii#recuperare" class="group block bg-gradient-to-br from-[#FAF3E7] to-[#F5EDE0] border border-[#E8DDD0] rounded-2xl p-7 hover:shadow-lg transition-all duration-300 hover:-translate-y-1 reveal" style="transition-delay:0.2s">
          <div class="w-12 h-12 bg-[#2C6E7F]/10 rounded-xl flex items-center justify-center mb-5 text-2xl">🔄</div>
          <h3 class="font-heading text-xl font-bold text-[#2C6E7F] mb-3">Te-ai pierdut undeva prin materie?</h3>
          <p class="text-[#6B5B5E] text-sm leading-relaxed mb-4">Pentru orice clasă, orice vârstă. Ai un capitol care ține loc restului? Venim exact pe ce te blochează — fără abonament, fără minim de ședințe.</p>
          <span class="inline-flex items-center gap-1 text-[#2C6E7F] text-sm font-semibold group-hover:gap-2 transition-all">Află mai mult <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
        </a>
      </div>
    </div>
  </section>

  <!-- DE CE NOI -->
  <section class="py-16 lg:py-24 bg-[#FAF3E7]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 reveal">
        <h2 class="font-heading text-3xl lg:text-4xl font-bold text-[#2A1518] mb-4">De ce noi</h2>
        <p class="text-[#6B5B5E] text-lg">Știm cum e să fii elev. Nu demult eram și noi.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { icon: '👩‍🏫', titlu: 'Profesori tineri care înțeleg', text: 'Suntem o echipă de oameni tineri care știm cum e să nu înțelegi ceva și să îți fie teamă să recunoști. Nu judecăm, explicăm.' },
          { icon: '🔍', titlu: 'Test inițial gratuit înainte să decizi', text: 'Înainte de orice, vii la o ședință gratuită. Facem un test, vedem exact unde ești, stabilim un plan. Tu decizi după dacă mergi mai departe.' },
          { icon: '⏱️', titlu: 'Pe ritmul tău, nu pe al școlii', text: 'Dacă profa de la școală vorbește prea repede, noi vorbim pe ritmul tău. Repetăm de câte ori e nevoie. Orice întrebare e binevenită.' },
          { icon: '💻', titlu: 'Online sau la sediu, cum vrei', text: 'Lucrăm fizic la sediul din Constanța sau online pe Zoom/Meet — la fel de eficient, tu alegi ce ți se potrivește.' },
        ].map((item, i) => (
          <div class="bg-white rounded-2xl p-6 shadow-sm border border-[#E8DDD0] reveal" style={`transition-delay:${i*0.1}s`}>
            <div class="text-3xl mb-4">{item.icon}</div>
            <h3 class="font-heading text-lg font-bold text-[#2A1518] mb-3">{item.titlu}</h3>
            <p class="text-[#6B5B5E] text-sm leading-relaxed">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CUM LUCRĂM -->
  <section id="cum-lucram" class="py-16 lg:py-24 bg-white scroll-mt-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 reveal">
        <h2 class="font-heading text-3xl lg:text-4xl font-bold text-[#2A1518] mb-4">Cum lucrăm</h2>
        <p class="text-[#6B5B5E] text-lg">Simplu și transparent — nicio surpriză.</p>
      </div>
      <div class="relative">
        <div class="hidden lg:block absolute top-12 left-[16.6%] right-[16.6%] h-0.5 bg-gradient-to-r from-[#E8B4BC] to-[#2C6E7F]/30"></div>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-6">
          {[
            { nr: '1', titlu: 'Ședință de cunoaștere gratuită + test inițial', text: 'Vii, ne cunoaștem, facem un test din toată materia. Vedem unde ești și de ce. Zero presiune, zero costuri.', culoare: 'bg-[#6B1F2E]' },
            { nr: '2', titlu: 'Stabilim împreună ce și cât avem de făcut', text: 'Pe baza testului, îți spunem sincer ce e realizabil și în cât timp. Tu decizi dacă mergi mai departe.', culoare: 'bg-[#2C6E7F]' },
            { nr: '3', titlu: 'Mergem pas cu pas, fără presiune', text: 'Lucrăm pe ritmul tău. Dacă nu ai înțeles, o luăm de la capăt — oricâte ori e nevoie. Materia care te sperie azi va fi cea pe care o explici tu colegilor.', culoare: 'bg-[#6B1F2E]' },
          ].map((pas, i) => (
            <div class="flex flex-col items-center text-center reveal" style={`transition-delay:${i*0.15}s`}>
              <div class={`w-16 h-16 ${pas.culoare} rounded-full flex items-center justify-center text-white font-heading text-2xl font-bold mb-5 shadow-md relative z-10`}>{pas.nr}</div>
              <h3 class="font-heading text-xl font-bold text-[#2A1518] mb-3">{pas.titlu}</h3>
              <p class="text-[#6B5B5E] text-sm leading-relaxed max-w-xs">{pas.text}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="text-center mt-10 reveal">
        <a href="/servicii#cunostinta" class="inline-flex items-center gap-2 bg-[#6B1F2E] text-white px-7 py-3.5 rounded-xl text-base font-semibold hover:bg-[#4E1520] transition-all duration-200 shadow-md hover:shadow-lg hover:-translate-y-0.5">
          Programează ședința gratuită
        </a>
      </div>
    </div>
  </section>

  <!-- MATERII -->
  <section class="py-16 lg:py-24 bg-[#FAF3E7]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 reveal">
        <h2 class="font-heading text-3xl lg:text-4xl font-bold text-[#2A1518] mb-4">Materiile pe care le acoperim</h2>
        <p class="text-[#6B5B5E] text-lg">Nu există materie «imposibilă» — există explicații care nu i s-au potrivit.</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4 lg:gap-6">
        {materii.map((materie, i) => (
          <a href={`/materii/${materie.slug}`} class="group bg-white rounded-2xl p-5 lg:p-6 shadow-sm border border-[#E8DDD0] hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 reveal" style={`transition-delay:${i*0.08}s`}>
            <div class={`w-10 h-10 ${materie.culoare} rounded-xl flex items-center justify-center text-xl mb-4`}>{materie.icon}</div>
            <h3 class="font-heading text-sm sm:text-base font-bold text-[#2A1518] mb-2 group-hover:text-[#6B1F2E] transition-colors">{materie.titlu}</h3>
            <p class="text-[#6B5B5E] text-xs sm:text-sm leading-relaxed mb-3">{materie.descriere}</p>
            <div class="flex flex-wrap gap-1">
              {materie.examene.map((ex) => (
                <span class="text-xs bg-[#FAF3E7] text-[#6B5B5E] px-2 py-0.5 rounded-full border border-[#E8DDD0]">{ex}</span>
              ))}
              <span class="text-xs bg-[#FAF3E7] text-[#6B5B5E] px-2 py-0.5 rounded-full border border-[#E8DDD0]">Recuperare</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- TESTIMONIALE -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 reveal">
        <h2 class="font-heading text-3xl lg:text-4xl font-bold text-[#2A1518] mb-4">Ce spun cei care au trecut pe la noi</h2>
        <p class="text-[#6B5B5E] text-lg">De la «nu înțeleg nimic» la «pot să o fac».</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {featuredTestimoniale.map((t, i) => (
          <div class="bg-[#FAF3E7] rounded-2xl p-6 lg:p-7 border border-[#E8DDD0] reveal" style={`transition-delay:${i*0.1}s`}>
            <div class="flex gap-1 mb-4">
              {[1,2,3,4,5].map((_) => (
                <svg class="w-4 h-4 text-[#6B1F2E]" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              ))}
            </div>
            <blockquote class="text-[#2A1518] text-sm leading-relaxed mb-5 italic">„{t.citat}"</blockquote>
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-[#6B1F2E]/10 rounded-full flex items-center justify-center shrink-0">
                <span class="text-[#6B1F2E] font-bold text-sm">{t.nume.charAt(0)}</span>
              </div>
              <div>
                <p class="font-semibold text-[#2A1518] text-sm">{t.nume}</p>
                <p class="text-[#6B5B5E] text-xs">{t.rol} · {t.materie}</p>
                {t.rezultat && <p class="text-[#2C6E7F] text-xs font-medium mt-0.5">✓ {t.rezultat}</p>}
              </div>
            </div>
          </div>
        ))}
      </div>
      <div class="text-center mt-8 reveal">
        <a href="/testimoniale" class="inline-flex items-center gap-2 text-[#6B1F2E] font-semibold hover:underline">
          Citește toate testimonialele
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="py-16 lg:py-24 bg-gradient-to-br from-[#6B1F2E] to-[#4E1520]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center reveal">
      <h2 class="font-heading text-3xl lg:text-4xl font-bold text-white mb-4">Gata să facem primul pas?</h2>
      <p class="text-white/80 text-lg mb-8 max-w-xl mx-auto">Vino la o ședință gratuită de cunoaștere. Vedem împreună unde ești și ce ai nevoie — fără obligații.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-8">
        <a href="/servicii#cunostinta" class="inline-flex items-center justify-center gap-2 bg-white text-[#6B1F2E] px-7 py-3.5 rounded-xl text-base font-bold hover:bg-[#FAF3E7] transition-all duration-200 shadow-md">
          Programează ședința gratuită
        </a>
        <a href="https://wa.me/40721628936?text=Bun%C4%83!%20Sunt%20interesat%20de%20medita%C8%9Bii%20la%20Centrul%20de%20Preg%C4%83tire" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 bg-[#25D366] text-white px-7 py-3.5 rounded-xl text-base font-bold hover:bg-[#1da851] transition-all duration-200">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Scrie pe WhatsApp
        </a>
      </div>
      <p class="text-white/60 text-sm">Sau sună la <a href="tel:+40721628936" class="text-white hover:underline font-medium">+40 721 628 936</a></p>
    </div>
  </section>
</Layout>
