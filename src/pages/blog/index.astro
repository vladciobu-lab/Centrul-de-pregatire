---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = ['Toate', 'Evaluare Națională', 'Bacalaureat', 'Sfaturi învățare', 'Pentru părinți'];
---

<Layout
  title="Blog"
  description="Articole despre pregătire pentru EN și BAC, sfaturi de învățare și ghiduri pentru părinți — de la echipa Centrul de Pregătire Constanța."
>
  <!-- Hero -->
  <section class="py-16 lg:py-20 bg-gradient-to-br from-[#FAF3E7] to-[#F0E4D5]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-heading text-4xl lg:text-5xl font-bold text-[#6B1F2E] mb-6 reveal">Blog</h1>
      <p class="text-lg text-[#6B5B5E] max-w-2xl mx-auto reveal" style="transition-delay:0.1s">
        Sfaturi de învățat, ghiduri pentru examene, și lucruri pe care le-am văzut că funcționează cu adevărat.
      </p>
    </div>
  </section>

  <!-- Filtre categorii -->
  <section class="bg-white border-b border-[#E8DDD0] py-4 sticky top-20 z-30">
    <div class="max-w-5xl mx-auto px-4 flex flex-wrap gap-2 justify-center">
      {categories.map((cat) => (
        <button class="cat-btn px-4 py-2 rounded-full text-sm font-medium border transition-all duration-200" data-cat={cat}>
          {cat}
        </button>
      ))}
    </div>
  </section>

  <!-- Articole -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      {posts.length === 0 ? (
        <p class="text-center text-[#6B5B5E]">Nu sunt articole disponibile momentan.</p>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="posts-grid">
          {posts.map((post, i) => (
            <article
              class="post-card group bg-[#FAF3E7] rounded-2xl overflow-hidden border border-[#E8DDD0] hover:shadow-lg hover:-translate-y-1 transition-all duration-300 reveal"
              data-cat={post.data.category}
              style={`transition-delay:${i*0.1}s`}
            >
              <a href={`/blog/${post.id}`} class="block">
                <!-- Image placeholder -->
                <div class="h-40 bg-gradient-to-br from-[#6B1F2E]/20 to-[#2C6E7F]/10 flex items-center justify-center">
                  <span class="text-5xl">
                    {post.data.category === 'Evaluare Națională' ? '🎯' :
                     post.data.category === 'Bacalaureat' ? '📚' :
                     post.data.category === 'Pentru părinți' ? '👪' : '💡'}
                  </span>
                </div>
                <div class="p-5 lg:p-6">
                  <div class="flex items-center gap-2 mb-3">
                    <span class="text-xs bg-[#6B1F2E]/10 text-[#6B1F2E] px-3 py-1 rounded-full font-medium">
                      {post.data.category}
                    </span>
                    <span class="text-[#6B5B5E] text-xs">
                      {post.data.pubDate.toLocaleDateString('ro-RO', { day: 'numeric', month: 'long', year: 'numeric' })}
                    </span>
                  </div>
                  <h2 class="font-heading text-lg font-bold text-[#2A1518] mb-2 group-hover:text-[#6B1F2E] transition-colors leading-snug">
                    {post.data.title}
                  </h2>
                  <p class="text-[#6B5B5E] text-sm leading-relaxed mb-4 line-clamp-3">
                    {post.data.description}
                  </p>
                  <div class="flex items-center justify-between">
                    <span class="text-[#6B5B5E] text-xs">{post.data.author}</span>
                    <span class="text-[#6B1F2E] text-sm font-semibold group-hover:underline">Citește →</span>
                  </div>
                </div>
              </a>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  .cat-btn {
    background: white;
    border-color: #E8DDD0;
    color: #2A1518;
  }
  .cat-btn:hover, .cat-btn.active {
    background: #6B1F2E;
    border-color: #6B1F2E;
    color: white;
  }
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script>
  const catBtns = document.querySelectorAll('.cat-btn');
  const postCards = document.querySelectorAll('.post-card');

  catBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const cat = btn.getAttribute('data-cat');
      catBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      postCards.forEach((card) => {
        const cardCat = card.getAttribute('data-cat');
        if (cat === 'Toate' || cardCat === cat) {
          (card as HTMLElement).style.display = 'block';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });

  catBtns[0]?.classList.add('active');
</script>
