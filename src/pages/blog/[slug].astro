---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);

const allPosts = await getCollection('blog');
const similare = allPosts
  .filter((p) => p.id !== post.id && p.data.category === post.data.category)
  .slice(0, 2);

const shareUrl = `https://centruldepregatire.ro/blog/${post.id}`;
const shareText = encodeURIComponent(post.data.title);
---

<Layout
  title={post.data.title}
  description={post.data.description}
>
  <!-- Breadcrumb -->
  <div class="bg-white border-b border-[#E8DDD0] py-3">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-[#6B5B5E]">
        <a href="/" class="hover:text-[#6B1F2E] transition-colors">Acasă</a>
        <span>/</span>
        <a href="/blog" class="hover:text-[#6B1F2E] transition-colors">Blog</a>
        <span>/</span>
        <span class="text-[#2A1518] font-medium truncate">{post.data.title}</span>
      </nav>
    </div>
  </div>

  <!-- Header articol -->
  <section class="py-12 lg:py-16 bg-gradient-to-br from-[#FAF3E7] to-[#F0E4D5]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-xs bg-[#6B1F2E]/10 text-[#6B1F2E] px-3 py-1 rounded-full font-medium">
          {post.data.category}
        </span>
        <span class="text-[#6B5B5E] text-sm">
          {post.data.pubDate.toLocaleDateString('ro-RO', { day: 'numeric', month: 'long', year: 'numeric' })}
        </span>
      </div>
      <h1 class="font-heading text-3xl lg:text-4xl font-bold text-[#2A1518] mb-4 reveal">
        {post.data.title}
      </h1>
      <p class="text-[#6B5B5E] text-lg leading-relaxed mb-4 reveal" style="transition-delay:0.1s">
        {post.data.description}
      </p>
      <p class="text-[#6B5B5E] text-sm reveal" style="transition-delay:0.15s">
        De: <strong class="text-[#2A1518]">{post.data.author}</strong>
      </p>
    </div>
  </section>

  <!-- Conținut articol -->
  <section class="py-12 lg:py-16 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="prose">
        <Content />
      </div>

      <!-- Share buttons -->
      <div class="mt-10 pt-8 border-t border-[#E8DDD0]">
        <p class="text-[#6B5B5E] text-sm font-medium mb-3">Distribuie articolul:</p>
        <div class="flex flex-wrap gap-3">
          <a
            href={`https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-[#1877F2] text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-[#1565c0] transition-colors"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
            Facebook
          </a>
          <a
            href={`https://wa.me/?text=${shareText}%20${shareUrl}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-[#25D366] text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-[#1da851] transition-colors"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp
          </a>
          <button
            id="copy-link"
            class="inline-flex items-center gap-2 bg-[#FAF3E7] text-[#6B1F2E] border border-[#E8DDD0] px-4 py-2 rounded-lg text-sm font-medium hover:bg-[#F0E4D5] transition-colors"
            data-url={shareUrl}
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
            <span id="copy-text">Copiază link</span>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Articole similare -->
  {similare.length > 0 && (
    <section class="py-12 bg-[#FAF3E7]">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="font-heading text-2xl font-bold text-[#2A1518] mb-6">Articole similare</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {similare.map((p) => (
            <a href={`/blog/${p.id}`} class="group bg-white rounded-2xl p-5 border border-[#E8DDD0] hover:shadow-md hover:-translate-y-0.5 transition-all duration-300">
              <span class="text-xs bg-[#6B1F2E]/10 text-[#6B1F2E] px-2 py-0.5 rounded-full font-medium">{p.data.category}</span>
              <h3 class="font-heading text-lg font-bold text-[#2A1518] mt-3 mb-2 group-hover:text-[#6B1F2E] transition-colors">{p.data.title}</h3>
              <p class="text-[#6B5B5E] text-sm line-clamp-2">{p.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="py-12 bg-gradient-to-br from-[#6B1F2E] to-[#4E1520]">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h2 class="font-heading text-2xl font-bold text-white mb-3">Ai o întrebare sau vrei să te pregătești?</h2>
      <p class="text-white/75 mb-6">Ședința de cunoaștere e gratuită și fără obligații.</p>
      <a href="/servicii#cunostinta" class="inline-flex items-center gap-2 bg-white text-[#6B1F2E] px-6 py-3 rounded-xl font-bold hover:bg-[#FAF3E7] transition-colors shadow-md">
        Programează acum gratuit
      </a>
    </div>
  </section>
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script>
  const copyBtn = document.getElementById('copy-link');
  const copyText = document.getElementById('copy-text');

  copyBtn?.addEventListener('click', async () => {
    const url = copyBtn.getAttribute('data-url') || window.location.href;
    try {
      await navigator.clipboard.writeText(url);
      if (copyText) copyText.textContent = 'Copiat!';
      setTimeout(() => { if (copyText) copyText.textContent = 'Copiază link'; }, 2000);
    } catch {
      // fallback
    }
  });
</script>
