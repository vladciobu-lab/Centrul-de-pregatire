---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
}

const {
  title,
  description = 'Meditații în Constanța pentru orice clasă și orice materie. Pregătire EN, BAC și recuperare. Ședință de cunoaștere gratuită. Plecăm de unde ești tu.',
  image = '/og-image.jpg',
  canonical,
} = Astro.props;

const siteUrl = 'https://centruldepregatire.ro';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).href;
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/jpeg" href="/logo.jpeg" />

    <title>{title} | Centrul de Pregătire Constanța</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${title} | Centrul de Pregătire Constanța`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${image}`} />
    <meta property="og:locale" content="ro_RO" />
    <meta property="og:site_name" content="Centrul de Pregătire Constanța" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Centrul de Pregătire Constanța`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${image}`} />

    <!-- SEO -->
    <meta name="robots" content="index, follow" />
    <meta name="keywords" content="meditații Constanța, meditații BAC Constanța, meditații Evaluare Națională Constanța, meditații matematică Constanța, meditații română Constanța, centru meditații Constanța, pregătire examen Constanța" />
    <meta name="author" content="Centrul de Pregătire Constanța" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "EducationalOrganization",
        "name": "Centrul de Pregătire Constanța",
        "description": "Meditații pentru orice clasă și orice materie în Constanța",
        "url": "https://centruldepregatire.ro",
        "telephone": "+40721628936",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Constanța",
          "addressCountry": "RO"
        }
      }
    </script>
  </head>
  <body>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />

    <script>
      // Reveal on scroll animation
      const revealElements = document.querySelectorAll('.reveal');
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        },
        { threshold: 0.1 }
      );
      revealElements.forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
